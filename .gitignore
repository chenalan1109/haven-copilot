__pycache__/
*.pyc
.DS_Store

# Everything Haven writes while running stays out of git: it can hold real
# session content. Only the simulated demo transcripts are tracked.
data/sessions/*
!data/sessions/C001-S03.json
!data/sessions/C001-S04.json
!data/sessions/C002-S05.json
# Simulated 36-minute session written by scripts/make_long_session.py; the B70 long-session benchmark ran on it.
!data/sessions/C002-L50.json
data/*.db
data/*.db-*
data/*.tmp
data/**/*.tmp
data/tmp/
data/audio/*
!data/audio/.gitkeep
# Written on the B70 copy by the sync, so results there name the commit they ran on.
SYNCED_COMMIT
batch9.log
